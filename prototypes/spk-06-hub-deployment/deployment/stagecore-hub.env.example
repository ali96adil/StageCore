# StageCore Hub deployment example.
# Bind to the dedicated stage LAN address in production after TLS/auth are enabled.
STAGECORE_BIND=127.0.0.1:3210
STAGECORE_INSTANCE_NAME=StageCore Main Stage
STAGECORE_DATA_ROOT=/var/lib/stagecore
# If Vault is a separately mounted SSD/NVMe path, change this and the systemd sandbox/mount directives together.
STAGECORE_VAULT_ROOT=/var/lib/stagecore/vault
