# Copy to /etc/stagecore/camera-relay.env and edit for the show LAN.
# This file contains no camera Wi-Fi credentials.
STAGECORE_CAMERA_RELAY_SOURCE=http://stagecam-d44a4c.local:81/api/v0/stream
STAGECORE_CAMERA_RELAY_LISTEN=192.168.3.130:9081
# Enable only after the camera firmware flash endpoint is physically qualified.
STAGECORE_CAMERA_RELAY_FLASH_WITH_VIEWERS=false
