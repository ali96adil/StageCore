# Example only. The packaged install-camera-relay.sh writes /etc/stagecore/camera-relay.env.
# This file contains no camera Wi-Fi credentials.
STAGECORE_CAMERA_RELAY_SOURCE=http://stagecam-xxxxxx.local:81/api/v0/stream
STAGECORE_CAMERA_RELAY_LISTEN=0.0.0.0:9081

# Optional; use the camera control port, not the MJPEG stream port.
STAGECORE_CAMERA_FLASH_CONTROL=http://stagecam-xxxxxx.local/api/v0/flash
